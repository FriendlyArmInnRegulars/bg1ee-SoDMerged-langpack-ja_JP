@19184 = ~[ALDETH 11]そんな！狂ってる！~ [ALDET11]
@19185 = ~[ALDETH 12]狂ってる！仲間内で戦う必要などないだろう！~ [ALDET12]
@19186 = ~[ALDETH 13]鬼め！まだ子供なのに！助けてくれ！~ [ALDET13]
@19187 = ~[ALDETH 14]もう何もいうことはない。~ [ALDET14]
@19188 = ~[ALDETH 15]私の話はもう聞いただろう。前に話したときから何も変ってないのだよ。~ [ALDET15]
@19189 = ~[ALDETH 16]ほっといてくれ！一人にしてくれ！~ [ALDET16]
@19190 = ~ゾルドラル~
@19191 = ~ゾルドラル~
@19192 = ~ラカダール~
@19193 = ~ラカダール~
@19194 = ~アーチドルイド~
@19195 = ~ラスカル~
@19196 = ~ウインスキー~
@19197 = ~ウインスキー~
@19198 = ~ケラッチャス~
@19199 = ~ケラッチャス~
