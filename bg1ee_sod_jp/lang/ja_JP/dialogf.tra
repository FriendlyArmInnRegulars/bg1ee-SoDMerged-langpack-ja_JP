@68729 = ~留武無功！~ [BD68729]
@68730 = ~別の道を求めない者には、すべての命が終わりを告げる。~ [MALE7w]
@68731 = ~正義のために！~ [MALE8a]
@68732 = ~突撃！~ [MALE88]
@68733 = ~逃げたければ逃げろ、遠くは行けないぞ！~ [MALE89]
@68734 = ~正義と力！~ [BD68734]
@68735 = ~鐘がお前のために鳴っている！死の鐘が！~ [BD68735]
@68736 = ~私についてこい、きっと勝利する！~ [MALE8b]
@68737 = ~英雄であることは大変な仕事だ。休む時だ。~ [MALE8c]
@68738 = ~先に進めないか？今すぐ？もうすぐ？早すぎるか。~ [MALE8d]
@68739 = ~傷ついているが、見ろ！戦い続けている！~ [MALE8e]
@68740 = ~私が必要か？~ [MALE8f]
@68741 = ~ん？~ [MALE8g]
@68742 = ~はい？~ [MALE8h]
@68743 = ~何かお手伝いできることは？~ [MALE80]
@68744 = ~私だ。~ [BD68744]
@68745 = ~何が気になる？~ [BD68745]
@68746 = ~助けに来た！~ [MALE8i]
@68747 = ~はは！~ [MALE8j]
@68748 = ~すぐに！~ [MALE8k]
@68749 = ~英雄の出番だ。~ [MALE8s]
@68750 = ~もう終わった。~ [MALE8t]
@68751 = ~私の仕事だ！~ [MALE8u]
@68752 = ~熱心に！~ [MALE8v]
@68753 = ~あああ、駄目！~ [MALE8l]
@68754 = ~すべてが冷たくなり...そして...静寂。~ [MALE8m]
@68755 = ~荒野の小さな毛玉の生き物を守らねばならない。しかし牙と怒りの問題を持つ大きなやつらは別だ。~ [MALE8n]
@68756 = ~街の人々はみんな忙しく動き回っている。~ [MALE8o]
@68757 = ~ここには死と危険がある。そして破壊も。もしかしたら...ドラマも？~ [MALE8p]
@68758 = ~早起きして、豊かで賢くなろう！健康でも。~ [MALE8q]
@68759 = ~おやすみ、太陽。おやすみ、昼間の生き物たち。おやすみ、剣。~ [MALE8r]
@68760 = ~私がいるから恐れるな！あなたが悪でない限り。悪なら大いに恐れろ。すべての恐怖を！~ [MALE8x]
@68761 = ~英雄にはいつもやるべきことがある。リストを作った方がいいかも。~ [MALE8y]
@68762 = ~君が機知に富んだコメントをしているのを聞いたことがない。いつも私が場を明るくしなければならない！よろしい。この挑戦を受けて立とう。~ [BD68762]
@68763 = ~脆弱だところを狙え！目か、いざとなったらあそこだ。~ [BD68763]
@68764 = ~お前にふさわしいだけだ！~ [MALE8z]
@68765 = ~こっちに戻れ！~ [MALE81]
@68766 = ~いつ引くかわかっている。他の手を試す時だ。~ [MALE82]
@68767 = ~もう入る場所がない。落とした。~ [MALE83]
@68768 = ~私の方があなたより必要だ。~ [MALE84]
@68769 = ~風のように姿を消した。~ [MALE85]
@68770 = ~魔法が失敗した。~ [MALE86]
@68771 = ~罠を仕掛けた。さあ、餌だ。~ [MALE87]
@68772 = ~どこでも尊敬され賞賛されている。それが我々だ。~ [BD68772]
@68773 = ~私の忍耐力が他の部分と同じくらい大きいと思っているかもしれないが、そうではない。~ [BD68773]
@68774 = ~先ほど言い間違えただろうか？あなたの行動への不快感を示すつもりだった。警告しておく。~ [BD68774]
@68775 = ~多くの稍を与えたが、あれが最後の一本だった。もう去る。~ [BD68775]
@68776 = ~私は...必ず...戻ってくる！~ [BD68776]
@68777 = ~英雄は決して死なない、その物語が生き続けるから。~ [MALE8w]
@68778 = ~勝ち目はない！~ [FEMALE7a]
@68779 = ~いくぜ。~ [FEMALE78]
@68780 = ~死という病気にかかっているな。~ [FEMALE79]
@68781 = ~お前の時間は終わった、相棒。~ [BD68781]
@68782 = ~私は止められない！~ [BD68782]
@68783 = ~これは名誉なことです。何を言えばいいかわからない。あ、わかった！ついてきて！~ [FEMALE7b]
@68784 = ~あくび。今日は本当によくやった。ちょっと仕仮眠する時かも？~ [FEMALE7c]
@68785 = ~なぜこんなところで立ち尽くしているの？黄金と栄光は空から降ってこないんだから。~ [FEMALE7d]
@68786 = ~うっ！けがした！~ [FEMALE7e]
@68787 = ~うん？~ [FEMALE7f]
