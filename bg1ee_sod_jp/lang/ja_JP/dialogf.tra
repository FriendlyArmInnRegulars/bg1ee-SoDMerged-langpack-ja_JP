@13802 = ~[LENORE 1]お願いだ、イルメイターの神よ、彼を家へ帰してくれ。~
@13803 = ~[LENORE 2]ひどすぎる！もう耐えられん！~
@13804 = ~[LENORE 3]下劣な生き物め！もうそれ以上好きにさせんぞ！~
@13805 = ~[LENORE 8]私？きちんと導くつもりだ。~
@13806 = ~[LENORE 17]何をしましょうか？~
@13807 = ~[LENORE 18]何をすればいいのか？~
@13808 = ~[LENORE 19]ただ方向を示してください。~
@13809 = ~[LENORE 20]イルメイターよ、保護を。~
@13810 = ~[LENORE 21]間違いなく。~
@13811 = ~[LENORE 22]できる限り。~
@13812 = ~[LENORE 27]そ、その身体は、ま、まるでーー！~
@13813 = ~[LENORE 28]我がモントゴメリー。愛しき人！~
@13814 = ~[LENORE 29]ああ、ほとんど出来ることがない。進め…。~
@13815 = ~[LENORE 30]みんなあなたの仕業だったのか？　それでは死ね！~
@13816 = ~[LENORE 31]美の破壊者！誓って殺してやる！~
