@5886  = ~[GREATER DOPPLEGANGER 04]~ [GDOPP04]
@5887  = ~[GREATER DOPPLEGANGER 05]~ [GDOPP05]
@5888  = ~[GREATER DOPPLEGANGER 06]~ [GDOPP06]
@5889  = ~[GREATER DOPPLEGANGER 07]~ [GDOPP07]
