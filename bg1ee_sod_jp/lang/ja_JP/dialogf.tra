@13659 = ~[TOWNSFOLK, MALE, BEREGOST 5 (BORLAND) POST HIGH CHAR.]やあ、元気か。ベレゴストの慎ましやかな豪華さを楽しんでるか？~
@13660 = ~[TOWNSFOLK, MALE, BEREGOST 5 (BORLAND) POST LOW CHAR.]私の家じゃ歓迎できないね。めったに言わない言葉だが本当だ。どうか帰ってくれ。~
@13661 = ~[TOWNSFOLK, MALE, BEREGOST 5 (BORLAND) HOSTILE]悪いが、すぐ帰ってくれないか。~
@13662 = ~[TOWNSFOLK, MALE, BEREGOST 8 POST]邪魔しないでくれ、荷造りで忙しいんだ。~
@13663 = ~[TOWNSFOLK, MALE, BEREGOST 8 HOSTILE]私の我慢もこれまでだ！消えな！~
@13664 = ~[TOWNSFOLK, MALE, BEREGOST 9 HOSTILE]私の前から消えろ！お前にしてやれることなどない！~
@13665 = ~[TOWNSFOLK, MALE, BEREGOST 6 HOSTILE]どっか行け！俺に用なんかない筈だ！~
@13666 = ~[TOWNSFOLK, MALE/BALDUR'S GATE HOSTILE]あとちょっとでも近寄れば、耳を切り落とすぞ！~
@13667 = ~[TOWNSFOLK, MALE/BEREGOST HOSTILE]耳を切り落とされなたくなかったら、もうそれ以上近付くな！~
@13668 = ~[TOWNSFOLK, MALE/FRIENDLY ARM HOSTILE]あと一歩進めば、お前の耳はなくなったと思え！~
@13669 = ~[TOWNSFOLK/TOWN CRIER/BEREGOST HOSTILE]ほっといてくれ！忙しいんだ！~
@13670 = ~[TRANZIG HOSTILE]失せな！俺に用ねぇだろ！~
@13671 = ~[TRAVELER - FRIENDLY ARM INN (WADE) POST HIGH CHAR.]だからそいつに言ってやったんだー、「もしそれがお前ェの姉貴なら俺の嫁さんはどこだって？」　ああ、こりゃ悪いね、唾飛んだ？ああ、友だちが戻ってきた！ホコリだらけの道を帰るのに充分なだけの勇気を飲んでんだ。もう少しいようかな。空は晴れてるが俺の頭は雲っちまってんな。~
@13672 = ~[TRAVELER - FRIENDLY ARM INN (WADE) POST LOW CHAR.]驚いただろ？無愛想な男が浮陽気な土地にやってきましたー。もうちょっと愛想よくしろよ？~
@13673 = ~[TRAVELER - FRIENDLY ARM INN (WADE) HOSTILE]悪いが、すぐ帰ってくれ。~
@13674 = ~[TRAVELER 2 HOSTILE]申し訳ないけど、もう行ってくれるか。~
@13675 = ~[VICONIA POST]寄るんじゃないよ、ウジ虫が！~
@13676 = ~[VOLO'S SERVING WENCH HOSTILE]私の我慢も限界！失せろ！~
@13677 = ~[WAITER HOSTILE]どっか行けよ！お前に何かしてやる気なんてないぞ！~
@13678 = ~[WATCHER 2 HOSTILE]あんなことしといて俺のそばに近寄るな！~
@13679 = ~[WILTON POST]悪いな若いの、たくさん耕すとこがあんだよ。~
@13680 = ~[WILTON HOSTILE]一人にしてくれ。お前に渡すものは何もねぇ。~
@13681 = ~[XAN POST]突然で申し訳ないですが、もう帰ります…。今すぐに…。~
@13682 = ~[YAGO POST]まだ邪魔したりないのか！~
@13683 = ~[YAGO HOSTILE]消えてくれ！何もしてやろうなんて思わないぞ！~
@13684 = ~[YESLICK POST]また会えてうれしいよ。ああ、もうそろそろ行かないとな。片づけなきゃいけないことがあるんだ。~
